# Copy this file to .env and change the values. Never commit .env to Git.
# This file is for development. In production these values live in AWS Parameter
# Store under /clinisar/production/ (docs/DEPLOY.md, step 7).

# --- Django ---
# Which settings file to use: config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Long random string. Required in production.
DJANGO_SECRET_KEY=change-me
# Comma-separated host names the API answers to (production only).
DJANGO_ALLOWED_HOSTS=api.example.com
# Comma-separated front-end addresses allowed to call the API (production only).
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- PostgreSQL ---
POSTGRES_DB=clinisar
POSTGRES_USER=clinisar
POSTGRES_PASSWORD=clinisar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- File storage (production only) ---
# Private S3 bucket for uploaded documents and lab result files.
AWS_STORAGE_BUCKET_NAME=clinisar-media
AWS_S3_REGION_NAME=ap-south-1

# --- Production only (docs/DEPLOY.md) ---
# The API's address, used by nginx for its certificate and server name.
API_DOMAIN=api.example.com
# Number of Gunicorn worker processes (about 2 x CPU cores + 1).
GUNICORN_WORKERS=3
# Front end: set as a GitHub variable (API_URL) and passed to the build as
# VITE_API_URL, e.g. https://api.example.com (no trailing slash).
